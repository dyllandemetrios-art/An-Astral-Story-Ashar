  m_Script: {fileID: 11500000, guid: 02f0317f8d354e349949875d9b448c42, type: 3}
  m_Name: DialogueData_TestBossArrival
  m_EditorClassIdentifier: Ashar.Runtime::Ashar.Dialogue.DialogueData
  _id: TestBossArrival
  _lines:
  - _speakerName: AMARA
    _textFr: "Attendez ! Ces vaisseaux\u2026 c'est mon escadrille. Ils les ont captur\xE9s."
    _textEn: '[EN placeholder] Wait! Those ships... that''s my squadron. They''ve been captured.'
    _voiceClip: {fileID: 0}
  - _speakerName: KAAL'VARIS
    _textFr: 'Escadrille d''Amara, si vous me recevez : attaquons ce monstre de front !'
    _textEn: '[EN placeholder] Amara''s squadron, if you read me: let''s hit this monster head-on!'
    _voiceClip: {fileID: 0}
